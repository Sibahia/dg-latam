{
    "name": "dungeon-blitz-r",
    "version": "1.28.3",
    "packageManager": "pnpm@11.9.0",

    "description": "Dungeon Blitz: R",
    "main": "index.js",
    "scripts": {
        "dev": "concurrently -n GAME,RPC -c blue,magenta \"pnpm --filter server run dev\" \"pnpm --filter server run dev:discord-bridge\"",
        "predev:built": "pnpm run build",
        "dev:built": "concurrently -n GAME,RPC -c blue,magenta \"pnpm --filter server run dev:built\" \"pnpm --filter server run dev:discord-bridge:built\"",
        "multiplayer": "pnpm --filter server run multiplayer:pm2",
        "build": "pnpm --filter server run build",
        "verify:client-patches": "pnpm --filter server run verify:client-patches",
        "start:discord-bridge": "pnpm --filter server run start:discord-bridge",
        "launch:multiplayer-with-discord": "node src/server/tools/launchMultiplayerClient.js",
        "install:discord-social-sdk": "node src/server/tools/installDiscordSocialSdk.js",
        "install:discord-bridge-autostart": "node src/server/tools/installDiscordBridgeAutostart.js",
        "remove:discord-bridge-autostart": "node src/server/tools/removeDiscordBridgeAutostart.js",
        "reset-password": "pnpm --filter server run reset-password --",
        "migrate:game-data-to-mongo": "pnpm --filter server run migrate:game-data-to-mongo --",
        "admin": "node --env-file-if-exists=src/server/.env src/server/tools/adminPanelServer.js"
    },
    "devDependencies": {
        "concurrently": "^10.0.3"
    },
    "author": "The Minesa Studios",
    "license": "MIT"
}
